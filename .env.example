# simrs = connect to SIMRS Khanza MySQL (default). standalone = own MariaDB, no Khanza DB.
MAPPER_MODE=simrs

# MySQL DSN
#
# simrs mode — same database as SIMRS Khanza:
DATABASE_DSN=user:password@tcp(host.docker.internal:3306)/sik?parseTime=true&loc=Local&charset=utf8mb4
#
# standalone mode — docker compose -f docker-compose.standalone.yml
# DATABASE_DSN is set by that compose file; for host-run against bundled MariaDB:
# DATABASE_DSN=mapper:mapper@tcp(127.0.0.1:3307)/mapper?parseTime=true&loc=Local&charset=utf8mb4

# HTTP Basic Auth for UI and /api/v1 mapping endpoints
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

APP_LISTEN=:8080
APP_PORT=8080
APP_ENV=development

# Hospital timezone for MedQLab datetime → SIMRS DATE/TIME (IANA name).
# Falls back to TZ, then process local time if both empty.
# Indonesia examples: Asia/Jakarta (WIB) | Asia/Makassar (WITA) | Asia/Jayapura (WIT) | Asia/Pontianak
APP_TIMEZONE=Asia/Jakarta

# MedQLab push result API (POST /api/v1/medqlab/hasil)
# Header: X-API-Key or Authorization: Bearer <key>
# Generate e.g.: openssl rand -hex 32
MEDQLAB_WEBHOOK_API_KEY=change-me-webhook-key
# SIMRS petugas NIP fallback for periksa_lab.nip when payload has no idEmployeeVerify
MEDQLAB_BRIDGING_NIP=0

# Host port for bundled MariaDB (docker-compose.standalone.yml)
MYSQL_PORT=3307

# Optional: run migrations then exit (no HTTP server)
# MIGRATE_ONLY=true
