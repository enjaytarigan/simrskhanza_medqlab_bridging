# SIMRS mode — app connects to Khanza MySQL and can POST hasil.
# Copy: cp .env.example .env
# Run:  docker compose up -d --build

MAPPER_MODE=simrs

# Same database as SIMRS Khanza
DATABASE_DSN=user:password@tcp(host.docker.internal:3306)/sik?parseTime=true&loc=Local&charset=utf8mb4

AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

APP_LISTEN=:8080
APP_PORT=8080
APP_ENV=production

# Hospital timezone for MedQLab datetime → SIMRS DATE/TIME (IANA name).
# Falls back to TZ, then process local time if both empty.
# Indonesia: Asia/Jakarta (WIB) | Asia/Makassar (WITA) | Asia/Jayapura (WIT) | Asia/Pontianak
APP_TIMEZONE=Asia/Jakarta

# POST /api/v1/medqlab/hasil  (X-API-Key or Authorization: Bearer)
# Generate: openssl rand -hex 32
MEDQLAB_WEBHOOK_API_KEY=change-me-webhook-key
# periksa_lab.nip when payload has no idEmployeeVerify
MEDQLAB_BRIDGING_NIP=0

# Opt-in poller: read permintaan_lab, POST /api/v1/saveOrder, record no_laboratorium.
# Requires MAPPER_MODE=simrs. Off by default.
MEDQLAB_ORDER_POLL=false
MEDQLAB_BASE_URL=https://lis.example
MEDQLAB_X_CONS=change-me-consid
MEDQLAB_X_SIGN=change-me-secret
# Orders with tgl_permintaan on or after this date (yyyy-MM-dd). Required when poll is on.
MEDQLAB_ORDER_SINCE=2026-10-01
MEDQLAB_ORDER_INTERVAL=5s
MEDQLAB_ORDER_CLAIM_TIMEOUT=2m

# MIGRATE_ONLY=true
