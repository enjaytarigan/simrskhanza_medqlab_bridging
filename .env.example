# SIMRS mode — app connects to Khanza MySQL and can POST hasil.
# Copy: cp .env.example .env
# Run:  docker compose up -d --build

MAPPER_MODE=simrs

# Same database as SIMRS Khanza
DATABASE_DSN=user:password@tcp(host.docker.internal:3306)/sik?parseTime=true&loc=Local&charset=utf8mb4

AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

APP_LISTEN=:8080
APP_PORT=8080
APP_ENV=production

# Hospital timezone for MedQLab datetime → SIMRS DATE/TIME (IANA name).
# Falls back to TZ, then process local time if both empty.
# Indonesia: Asia/Jakarta (WIB) | Asia/Makassar (WITA) | Asia/Jayapura (WIT) | Asia/Pontianak
APP_TIMEZONE=Asia/Jakarta

# POST /api/v1/medqlab/hasil  (X-API-Key or Authorization: Bearer)
# Generate: openssl rand -hex 32
MEDQLAB_WEBHOOK_API_KEY=change-me-webhook-key
# periksa_lab.nip when payload has no idEmployeeVerify
MEDQLAB_BRIDGING_NIP=0

# MIGRATE_ONLY=true
