# Standalone mode — own MariaDB, no Khanza DB. Hasil push is disabled.
# Copy: cp .env.standalone.example .env
# Run:  docker compose -f docker-compose.standalone.yml up -d --build

MAPPER_MODE=standalone

# Compose overrides DATABASE_DSN to the bundled MariaDB (service mysql).
# For ./scripts/run-local.sh against that MariaDB on the host:
DATABASE_DSN=mapper:mapper@tcp(127.0.0.1:3307)/mapper?parseTime=true&loc=Local&charset=utf8mb4

AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

APP_LISTEN=:8080
APP_PORT=8080
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta

# POST /api/v1/mappings/resolve  (X-API-Key or Authorization: Bearer)
# Same key as LIS_KHANZA_MAPPER_API_KEY on medqlabv2_bridging.
# Generate: openssl rand -hex 32
MEDQLAB_WEBHOOK_API_KEY=change-me-webhook-key

# Host port for bundled MariaDB
MYSQL_PORT=3307
# MariaDB files on the host (not Docker named volume storage)
MYSQL_DATA_DIR=./data/mysql

# MIGRATE_ONLY=true
